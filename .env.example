# Fill only with tokens from activated provider accounts. Blank disables the provider.
DNI_TOKEN_APISPERU=
DNI_TOKEN_FACTILIZA=
DNI_TOKEN_PERUAPI_COM=

# Optional monthly renewal day for the Peru API account. Default: 1.
DNI_PERUAPI_COM_BILLING_DAY=

# Token for the local HTTP client. Generate 32 random bytes encoded as base64url.
DNI_CLIENT_TOKEN=
DNI_LOCAL_PORT=3000
